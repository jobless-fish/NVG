# Fresh live data plane, kept separate from review/test volumes.
COMPOSE_PROJECT_NAME=nodeverse-v2-live
COLLECTOR_BIND=127.0.0.1
COLLECTOR_PORT=8003
MONGO_BIND=127.0.0.1
MONGO_PORT=27020
REMOTE_EXPORT_ENABLED=1
BRONZE_TRIGGER=5 seconds
STAGE_TRIGGER=1 second
SPARK_CORES=4
SPARK_DRIVER_MEMORY=2g
SHUFFLE_PARTITIONS=4
MAX_OFFSETS_PER_TRIGGER=10000
