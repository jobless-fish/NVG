{
  "name": "nodeverse-dev",
  "services": {
    "kafka-1": {
      "image": "apache/kafka:3.9.1",
      "hostname": "kafka-1",
      "restart": "unless-stopped",
      "environment": {
        "CLUSTER_ID": "MkU3OEVBNTcwNTJENDM2Qk",
        "KAFKA_NODE_ID": 1,
        "KAFKA_PROCESS_ROLES": "broker,controller",
        "KAFKA_CONTROLLER_QUORUM_VOTERS": "1@kafka-1:9093,2@kafka-2:9093,3@kafka-3:9093",
        "KAFKA_LISTENERS": "PLAINTEXT://:9092,CONTROLLER://:9093",
        "KAFKA_ADVERTISED_LISTENERS": "PLAINTEXT://kafka-1:9092",
        "KAFKA_LISTENER_SECURITY_PROTOCOL_MAP": "CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT",
        "KAFKA_CONTROLLER_LISTENER_NAMES": "CONTROLLER",
        "KAFKA_INTER_BROKER_LISTENER_NAME": "PLAINTEXT",
        "KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR": 3,
        "KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR": 3,
        "KAFKA_TRANSACTION_STATE_LOG_MIN_ISR": 2,
        "KAFKA_MIN_INSYNC_REPLICAS": 2,
        "KAFKA_AUTO_CREATE_TOPICS_ENABLE": "false",
        "KAFKA_LOG_DIRS": "/var/lib/kafka/data",
        "KAFKA_HEAP_OPTS": "-Xms256m -Xmx512m"
      },
      "volumes": [
        "kafka-1:/var/lib/kafka/data"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "/opt/kafka/bin/kafka-topics.sh --bootstrap-server localhost:9092 --list >/dev/null 2>&1"
        ],
        "interval": "10s",
        "timeout": "10s",
        "retries": 18,
        "start_period": "30s"
      }
    },
    "kafka-2": {
      "image": "apache/kafka:3.9.1",
      "hostname": "kafka-2",
      "restart": "unless-stopped",
      "environment": {
        "CLUSTER_ID": "MkU3OEVBNTcwNTJENDM2Qk",
        "KAFKA_NODE_ID": 2,
        "KAFKA_PROCESS_ROLES": "broker,controller",
        "KAFKA_CONTROLLER_QUORUM_VOTERS": "1@kafka-1:9093,2@kafka-2:9093,3@kafka-3:9093",
        "KAFKA_LISTENERS": "PLAINTEXT://:9092,CONTROLLER://:9093",
        "KAFKA_ADVERTISED_LISTENERS": "PLAINTEXT://kafka-2:9092",
        "KAFKA_LISTENER_SECURITY_PROTOCOL_MAP": "CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT",
        "KAFKA_CONTROLLER_LISTENER_NAMES": "CONTROLLER",
        "KAFKA_INTER_BROKER_LISTENER_NAME": "PLAINTEXT",
        "KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR": 3,
        "KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR": 3,
        "KAFKA_TRANSACTION_STATE_LOG_MIN_ISR": 2,
        "KAFKA_MIN_INSYNC_REPLICAS": 2,
        "KAFKA_AUTO_CREATE_TOPICS_ENABLE": "false",
        "KAFKA_LOG_DIRS": "/var/lib/kafka/data",
        "KAFKA_HEAP_OPTS": "-Xms256m -Xmx512m"
      },
      "volumes": [
        "kafka-2:/var/lib/kafka/data"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "/opt/kafka/bin/kafka-topics.sh --bootstrap-server localhost:9092 --list >/dev/null 2>&1"
        ],
        "interval": "10s",
        "timeout": "10s",
        "retries": 18,
        "start_period": "30s"
      }
    },
    "kafka-3": {
      "image": "apache/kafka:3.9.1",
      "hostname": "kafka-3",
      "restart": "unless-stopped",
      "environment": {
        "CLUSTER_ID": "MkU3OEVBNTcwNTJENDM2Qk",
        "KAFKA_NODE_ID": 3,
        "KAFKA_PROCESS_ROLES": "broker,controller",
        "KAFKA_CONTROLLER_QUORUM_VOTERS": "1@kafka-1:9093,2@kafka-2:9093,3@kafka-3:9093",
        "KAFKA_LISTENERS": "PLAINTEXT://:9092,CONTROLLER://:9093",
        "KAFKA_ADVERTISED_LISTENERS": "PLAINTEXT://kafka-3:9092",
        "KAFKA_LISTENER_SECURITY_PROTOCOL_MAP": "CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT",
        "KAFKA_CONTROLLER_LISTENER_NAMES": "CONTROLLER",
        "KAFKA_INTER_BROKER_LISTENER_NAME": "PLAINTEXT",
        "KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR": 3,
        "KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR": 3,
        "KAFKA_TRANSACTION_STATE_LOG_MIN_ISR": 2,
        "KAFKA_MIN_INSYNC_REPLICAS": 2,
        "KAFKA_AUTO_CREATE_TOPICS_ENABLE": "false",
        "KAFKA_LOG_DIRS": "/var/lib/kafka/data",
        "KAFKA_HEAP_OPTS": "-Xms256m -Xmx512m"
      },
      "volumes": [
        "kafka-3:/var/lib/kafka/data"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "/opt/kafka/bin/kafka-topics.sh --bootstrap-server localhost:9092 --list >/dev/null 2>&1"
        ],
        "interval": "10s",
        "timeout": "10s",
        "retries": 18,
        "start_period": "30s"
      }
    },
    "topic-init": {
      "image": "apache/kafka:3.9.1",
      "depends_on": {
        "kafka-1": {
          "condition": "service_healthy"
        },
        "kafka-2": {
          "condition": "service_healthy"
        },
        "kafka-3": {
          "condition": "service_healthy"
        }
      },
      "entrypoint": [
        "/bin/bash",
        "-ec"
      ],
      "command": [
        "/opt/kafka/bin/kafka-topics.sh --bootstrap-server kafka-1:9092,kafka-2:9092,kafka-3:9092 --create --if-not-exists --topic nv.learning.v2 --partitions 6 --replication-factor 3 --config min.insync.replicas=2 --config retention.ms=604800000 && /opt/kafka/bin/kafka-topics.sh --bootstrap-server kafka-1:9092,kafka-2:9092,kafka-3:9092 --create --if-not-exists --topic nv.runtime.v1 --partitions 3 --replication-factor 3 --config min.insync.replicas=2 --config retention.ms=604800000 && /opt/kafka/bin/kafka-topics.sh --bootstrap-server kafka-1:9092,kafka-2:9092,kafka-3:9092 --create --if-not-exists --topic nv.bundle.v2 --partitions 3 --replication-factor 3 --config min.insync.replicas=2 --config retention.ms=604800000 && /opt/kafka/bin/kafka-topics.sh --bootstrap-server kafka-1:9092,kafka-2:9092,kafka-3:9092 --create --if-not-exists --topic nv.dlq.v1 --partitions 3 --replication-factor 3 --config min.insync.replicas=2 --config retention.ms=604800000 && /opt/kafka/bin/kafka-topics.sh --bootstrap-server kafka-1:9092,kafka-2:9092,kafka-3:9092 --create --if-not-exists --topic nv.update.v1 --partitions 3 --replication-factor 3 --config min.insync.replicas=2 --config retention.ms=604800000 && /opt/kafka/bin/kafka-topics.sh --bootstrap-server kafka-1:9092,kafka-2:9092,kafka-3:9092 --describe"
      ]
    },
    "collector": {
      "build": {
        "context": ".",
        "dockerfile": "Dockerfile"
      },
      "restart": "unless-stopped",
      "ports": [
        "${COLLECTOR_BIND:-127.0.0.1}:${COLLECTOR_PORT:-8000}:8000"
      ],
      "environment": {
        "INGEST_KEY": "${INGEST_KEY:?Set INGEST_KEY in .env}",
        "KAFKA_BOOTSTRAP": "kafka-1:9092,kafka-2:9092,kafka-3:9092",
        "MONGO_URI": "mongodb://mongo:27017",
        "MONGO_DB": "nodeverse_logs"
      },
      "depends_on": {
        "topic-init": {
          "condition": "service_completed_successfully"
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen(\"http://127.0.0.1:8000/health/ready\", timeout=3)"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 6,
        "start_period": "15s"
      }
    },
    "mongo": {
      "image": "mongo:7.0.16",
      "restart": "unless-stopped",
      "ports": [
        "${MONGO_BIND:-127.0.0.1}:${MONGO_PORT:-27017}:27017"
      ],
      "volumes": [
        "mongo:/data/db"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "mongosh",
          "--quiet",
          "--eval",
          "quit(db.adminCommand({ping:1}).ok ? 0 : 1)"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 6,
        "start_period": "10s"
      }
    },
    "spark": {
      "build": {
        "context": ".",
        "dockerfile": "Dockerfile.spark"
      },
      "user": "0:0",
      "restart": "unless-stopped",
      "entrypoint": [
        "/opt/spark/bin/spark-submit"
      ],
      "command": [
        "--master",
        "local[${SPARK_CORES:-4}]",
        "--driver-memory",
        "${SPARK_DRIVER_MEMORY:-2g}",
        "--conf",
        "spark.jars.ivy=/ivy",
        "--packages",
        "org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.3,io.delta:delta-spark_2.12:3.2.1",
        "--conf",
        "spark.sql.extensions=io.delta.sql.DeltaSparkSessionExtension",
        "--conf",
        "spark.sql.catalog.spark_catalog=org.apache.spark.sql.delta.catalog.DeltaCatalog",
        "--conf",
        "spark.sql.warehouse.dir=/data/delta",
        "--conf",
        "spark.sql.session.timeZone=UTC",
        "--py-files",
        "/app/tables.py",
        "/app/delta_stream.py"
      ],
      "environment": {
        "KAFKA_BOOTSTRAP": "kafka-1:9092,kafka-2:9092,kafka-3:9092",
        "MONGO_URI": "mongodb://mongo:27017",
        "MONGO_DB": "nodeverse_logs",
        "REMOTE_EXPORT_ENABLED": "${REMOTE_EXPORT_ENABLED:-0}",
        "BRONZE_TRIGGER": "${BRONZE_TRIGGER:-5 seconds}",
        "STAGE_TRIGGER": "${STAGE_TRIGGER:-1 second}",
        "SHUFFLE_PARTITIONS": "${SHUFFLE_PARTITIONS:-4}",
        "MAX_OFFSETS_PER_TRIGGER": "${MAX_OFFSETS_PER_TRIGGER:-10000}",
        "LAKE_ROOT": "/data/delta",
        "CHECKPOINT_ROOT": "/data/checkpoints",
        "TZ": "UTC",
        "INGEST_KEY": "${INGEST_KEY:?Set INGEST_KEY in .env}",
        "COLLECTOR_URL": "http://collector:8000"
      },
      "volumes": [
        "./spark:/app:ro",
        "./remote:/opt/nodeverse/remote:ro",
        "lake:/data",
        "ivy:/ivy"
      ],
      "depends_on": {
        "topic-init": {
          "condition": "service_completed_successfully"
        },
        "mongo": {
          "condition": "service_healthy"
        }
      }
    },
    "remote-writer": {
      "build": {
        "context": ".",
        "dockerfile": "Dockerfile"
      },
      "profiles": [
        "remote"
      ],
      "restart": "unless-stopped",
      "command": [
        "python",
        "-m",
        "remote.worker"
      ],
      "env_file": ".env.remote",
      "environment": {
        "MONGO_URI": "mongodb://mongo:27017",
        "MONGO_DB": "nodeverse_logs",
        "REMOTE_CONTEXT_PATH": "/run/private/remote-context.json"
      },
      "volumes": [
        "./.env.remote-context.json:/run/private/remote-context.json:ro"
      ],
      "depends_on": {
        "mongo": {
          "condition": "service_healthy"
        }
      }
    }
  },
  "volumes": {
    "lake": {},
    "mongo": {},
    "ivy": {},
    "kafka-1": {},
    "kafka-2": {},
    "kafka-3": {}
  }
}
