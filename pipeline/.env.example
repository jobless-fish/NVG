INGEST_KEY=replace-with-a-long-random-local-key

# Docker service DNS remains the same when the whole stack moves to another PC.
MONGO_URI=mongodb://mongo:27017
MONGO_DATABASE=nodeverse
# Keep empty for current Kafka. For a NEW Kafka cluster, set a NEW unique prefix.
KAFKA_EPOCH=
# Optional: bind dashboard to the new server LAN IP.
LAB_BIND_IP=127.0.0.1
